{
  "name": "bing-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "check:tokens": "node scripts/check-tokens.mjs",
    "typecheck": "npm run check:tokens && tsc --noEmit",
    "test": "vitest run",
    "build": "npm run check:tokens && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort"
  },
  "dependencies": {
    "@fluentui/react-icons": "2.0.270",
    "fast-xml-parser": "5.11.2",
    "motion": "12.42.2",
    "parse5": "^8.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.1",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "29.1.1",
    "typescript": "5.7.3",
    "vite": "5.4.14",
    "vitest": "4.1.10"
  }
}
