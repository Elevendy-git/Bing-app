# Optional public SPA identifier override. Never put a client secret in Vite environment variables.
VITE_MICROSOFT_CLIENT_ID=ec6fea2d-15f4-44ec-8954-5b49d94a2e2e

# Public data backend URL. Empty uses the local Vite API; for GitHub Pages use
# the HTTPS Render service URL, e.g. https://your-service.onrender.com.
# This value is embedded in the public frontend build. It is never used for Rewards or sign-in.
VITE_API_BASE_URL=

# Real, interactive Bing stream. Local development enables this by default.
# Production remains opt-in until the selected host has been verified.
# Set false to use the sanitized HTML transport while developing.
VITE_LIVE_BROWSER=
